   "fieldname": "statutory_disclosure_tab",
   "fieldtype": "Tab Break",
   "label": "Statutory Disclosure (s189(3))"
  },
  {
   "description": "s189(3)(a) - the reasons for the proposed dismissals",
   "fieldname": "reason_for_dismissals",
   "fieldtype": "Text Editor",
   "label": "Reason for the Contemplated Dismissals",
   "reqd": 1
  },
  {
   "description": "s189(3)(b) - alternatives considered before proposing the dismissals, and why they were rejected",
   "fieldname": "alternatives_considered",
   "fieldtype": "Text Editor",
   "label": "Alternatives Considered"
  },
  {
   "description": "s189(3)(d) - the proposed method for selecting which employees to dismiss",
   "fieldname": "selection_method",
   "fieldtype": "Text Editor",
   "label": "Proposed Method of Selection",
   "reqd": 1
  },
  {
   "fieldname": "section_break_timing",
   "fieldtype": "Section Break",
   "label": "Timing and Severance"
  },
  {
   "description": "s189(3)(e) - when, or the period during which, the dismissals are likely to take effect",
   "fieldname": "proposed_implementation_date",
   "fieldtype": "Date",
   "label": "Proposed Implementation Date"
  },
  {
   "fieldname": "implementation_notes",
   "fieldtype": "Small Text",
   "label": "Implementation / Notice Period Notes"
  },
  {
   "fieldname": "column_break_timing",
   "fieldtype": "Column Break"
  },
  {
   "description": "s189(3)(f) - the severance pay proposed. Note: s41 of the Basic Conditions of Employment Act sets the statutory minimum at one week's remuneration per completed year of service - see Costing Parameters below for the actual calculation basis.",
   "fieldname": "severance_pay_proposal",
   "fieldtype": "Text Editor",
   "label": "Proposed Severance Pay"
  },
  {
   "fieldname": "section_break_assistance",
   "fieldtype": "Section Break",
   "label": "Assistance and Re-employment"
  },
  {
   "description": "s189(3)(g) - any assistance the employer proposes to offer affected employees",
   "fieldname": "assistance_offered",
   "fieldtype": "Text Editor",
   "label": "Assistance Offered"
  },
  {
   "description": "s189(3)(h) - the possibility of future re-employment of employees who are dismissed",
   "fieldname": "future_reemployment",
   "fieldtype": "Text Editor",
   "label": "Possibility of Future Re-employment"
  },
  {
   "fieldname": "section_break_counts",
   "fieldtype": "Section Break",
   "label": "Statutory Headcounts"
  },
  {
   "description": "s189(3)(i) - the number of employees employed by the employer (active employees, this Company) - calculated automatically",
   "fieldname": "total_employees",
   "fieldtype": "Int",
   "label": "Total Employees (this Company)",
   "read_only": 1
  },
  {
   "fieldname": "column_break_counts",
   "fieldtype": "Column Break"
  },
  {
   "description": "s189(3)(j) - employees dismissed for operational requirements in the preceding 12 months. Calculated automatically from submitted Dismissal Forms unless overridden below (e.g. if this system doesn't yet hold accurate historical dismissal data).",
   "fieldname": "prior_operational_dismissals_12m",
   "fieldtype": "Int",
   "label": "Dismissed for Operational Requirements (Preceding 12 Months)",
   "read_only_depends_on": "eval:!doc.override_prior_dismissals_12m"
  },
  {
   "default": "0",
   "description": "Enable to manually set the figure above instead of trusting this system's own submitted Dismissal Forms",
   "fieldname": "override_prior_dismissals_12m",
   "fieldtype": "Check",
   "label": "Manually Override This Figure"
  },
  {
   "fieldname": "costing_tab",
   "fieldtype": "Tab Break",
   "label": "Costing"
  },
  {
   "fieldname": "costing_parameters_section",
   "fieldtype": "Section Break",
   "label": "Costing Parameters (negotiated severance terms)"
  },
  {
   "default": "1",
   "description": "The multiplier per completed year of service. Statutory minimum per s41 of the Basic Conditions of Employment Act is 1 week per completed year - negotiable upward (e.g. 2), never below the statutory minimum.",
   "fieldname": "severance_weeks_per_completed_year",
   "fieldtype": "Float",
   "label": "Severance Weeks Per Completed Year"
  },
  {
   "default": "45",
   "description": "What counts as \"one week's pay\" for severance purposes (basic rate only, no allowances)",
   "fieldname": "severance_hours_per_week",
   "fieldtype": "Float",
   "label": "Severance Hours Per Week"
  },
  {
   "fieldname": "column_break_costing_parameters",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "description": "A guaranteed floor, e.g. set to 1 so employees with 0 completed years still receive a minimum of 1 week's severance",
   "fieldname": "minimum_severance_weeks",
   "fieldtype": "Float",
   "label": "Minimum Severance Weeks"
