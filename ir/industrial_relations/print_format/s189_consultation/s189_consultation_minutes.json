 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div style=\\\"text-align: center; margin-bottom: 18px;\\\">\\n    <h3 style=\\\"margin: 0;\\\">Minutes of Consultation</h3>\\n    <p style=\\\"margin: 4px 0 0;\\\">{{ doc.linked_intervention or \\\"\\\" }}</p>\\n</div>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<table style=\\\"width: 100%; border: none; margin-bottom: 16px;\\\">\\n    <tr>\\n        <td style=\\\"border: none; padding: 2px 0; width: 25%;\\\"><strong>Date</strong></td>\\n        <td style=\\\"border: none; padding: 2px 0;\\\">{{ frappe.utils.formatdate(doc.consultation_date) if doc.consultation_date else \\\"\\\" }}</td>\\n        <td style=\\\"border: none; padding: 2px 0; width: 25%;\\\"><strong>Time</strong></td>\\n        <td style=\\\"border: none; padding: 2px 0;\\\">{{ frappe.utils.format_time(doc.consultation_time) if doc.consultation_time else \\\"\\\" }}</td>\\n    </tr>\\n    <tr>\\n        <td style=\\\"border: none; padding: 2px 0;\\\"><strong>Venue</strong></td>\\n        <td style=\\\"border: none; padding: 2px 0;\\\">{{ doc.venue or \\\"\\\" }}</td>\\n        <td style=\\\"border: none; padding: 2px 0;\\\"><strong>Type</strong></td>\\n        <td style=\\\"border: none; padding: 2px 0;\\\">{{ \\\"Bulk Consultation\\\" if doc.is_bulk_consultation else \\\"Individual Consultation\\\" }}</td>\\n    </tr>\\n</table>\\n\\n<h4 style=\\\"margin: 18px 0 8px;\\\">Attendees</h4>\\n<table style=\\\"width: 100%; border-collapse: collapse;\\\">\\n    <thead>\\n        <tr>\\n            <th style=\\\"border: 1px solid #ccc; padding: 6px; text-align: left;\\\">Name</th>\\n            <th style=\\\"border: 1px solid #ccc; padding: 6px; text-align: left;\\\">Type</th>\\n            <th style=\\\"border: 1px solid #ccc; padding: 6px; text-align: left;\\\">Represented By</th>\\n            <th style=\\\"border: 1px solid #ccc; padding: 6px; text-align: center;\\\">Attended</th>\\n            <th style=\\\"border: 1px solid #ccc; padding: 6px; text-align: left;\\\">Notes</th>\\n        </tr>\\n    </thead>\\n    <tbody>\\n        {% for row in doc.attendees %}\\n            <tr>\\n                <td style=\\\"border: 1px solid #ccc; padding: 6px;\\\">\\n                    {% if row.attendee_type == \\\"Employee\\\" %}{{ row.employee_name or row.employee or \\\"\\\" }}\\n                    {% elif row.attendee_type == \\\"Trade Union\\\" %}{{ row.trade_union or \\\"\\\" }}{% if row.contact_name %} - {{ row.contact_name }}{% endif %}\\n                    {% else %}{{ row.contact_name or \\\"\\\" }}{% endif %}\\n                </td>\\n                <td style=\\\"border: 1px solid #ccc; padding: 6px;\\\">{{ row.attendee_type or \\\"\\\" }}</td>\\n                <td style=\\\"border: 1px solid #ccc; padding: 6px;\\\">{{ row.represented_by or \\\"\\\" if row.attendee_type == \\\"Employee\\\" else \\\"\\\" }}</td>\\n                <td style=\\\"border: 1px solid #ccc; padding: 6px; text-align: center;\\\">{{ \\\"Yes\\\" if row.attended else \\\"No\\\" }}</td>\\n                <td style=\\\"border: 1px solid #ccc; padding: 6px;\\\">{{ row.notes or \\\"\\\" }}</td>\\n            </tr>\\n        {% endfor %}\\n    </tbody>\\n</table>\\n\\n<h4 style=\\\"margin: 18px 0 8px;\\\">Minutes</h4>\\n<div>{{ doc.minutes or \\\"\\\" }}</div>\"}]",
